{
  "name": "@local/dsh-chat-find",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "In-conversation find bar for the DeepSeek Harness desktop UI.",
  "license": "MIT",
  "author": "bulzz1233",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bulzz1233/dsh-chat-find.git"
  },
  "homepage": "https://github.com/bulzz1233/dsh-chat-find#readme",
  "bugs": {
    "url": "https://github.com/bulzz1233/dsh-chat-find/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "find",
    "search",
    "conversation"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
